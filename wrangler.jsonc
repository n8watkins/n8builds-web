{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The site as a Cloudflare Worker, built by OpenNext (see DEPLOY.md).
  // worker/index.js wraps the generated .open-next/worker.js.
  "name": "n8builds-web",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // nodejs_compat is required by OpenNext; global_fetch_strictly_public keeps
  // the server's own fetches (GitHub, Sanity) on the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Static assets answer a Range request with the whole file (200), and
    // Safari plays a <video> only when ranges work, so the worker serves the
    // videos itself (worker/range.js). Everything else in public/ and
    // /_next/static is served straight from the assets.
    "run_worker_first": ["/*.mp4", "/*.webm"]
  },
  // Next's image optimizer (next/image) runs on Cloudflare Images.
  "images": { "binding": "IMAGES" },
  // ISR (export const revalidate, fetch revalidate) keeps pages in R2, with a
  // Durable Object queue that deduplicates the background revalidations, and a
  // Durable Object tag cache for on-demand revalidation (Sanity's publish
  // webhook, app/api/sanity/revalidate).
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "n8builds-web-opennext-cache" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
      // The contact form's and waitlist's limits (lib/security/rateLimiter.ts,
      // worker/rate-limit-counter.js): 5 an hour per IP, the daily caps, the
      // auto-replies per address.
      { "name": "RATE_LIMIT_COUNTERS", "class_name": "RateLimitCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimitCounter"] },
    { "tag": "v3", "new_sqlite_classes": ["DOShardedTagCache"] }
  ],
  "services": [
    // The revalidation queue renders pages again by calling the worker itself.
    { "binding": "WORKER_SELF_REFERENCE", "service": "n8builds-web" },
    // Contact form, quote request and waitlist emails (lib/email/send.ts), from
    // contact@n8builds.dev through the shared mailroom Worker
    // (n8watkins/mailroom), which caps every send and fails closed.
    { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "n8builds-web" } }
  ],
  // The edge flood limit on the contact form (worker/index.js): 10 posts a
  // minute per IP, before Next runs. The app's own limits (5 an hour per IP,
  // lib/security/rateLimiter.ts) come after it.
  "ratelimits": [{ "name": "CONTACT_RATE_LIMITER", "namespace_id": "2101", "simple": { "limit": 10, "period": 60 } }],
  // The site's data (docs/DATABASE.md). This Worker owns both databases: only
  // this repository holds their migrations (npm run db:migrate). The admin
  // dashboard reads them, read-only in its code.
  "d1_databases": [
    // Personal data: the waitlist (lib/waitlist/store.ts).
    {
      "binding": "WAITLIST_DB",
      "database_name": "n8builds-waitlist",
      "database_id": "788b0aa9-fe2d-40ae-bcd4-b5590969ff60",
      "migrations_dir": "migrations/waitlist"
    },
    // Anonymous counts: short links, contact sends, the dino game.
    {
      "binding": "ANALYTICS_DB",
      "database_name": "n8builds-analytics",
      "database_id": "3a0b72c8-fa2e-4f82-9e48-5d2d5ec7eb5c",
      "migrations_dir": "migrations/analytics"
    }
  ],
  // The daily cleanup of expired rows in both databases (worker/index.js, lib/retention.ts).
  "triggers": { "crons": ["30 3 * * *"] },
  "vars": {
    // Replaces VERCEL_ENV: "production" here; unset locally and in tests.
    "APP_ENV": "production",
    "CONTACT_EMAIL_TO": "nathancwatkins23@gmail.com",
    // Server errors (worker/index.js). Public: the same DSN ships to browsers
    // as NEXT_PUBLIC_SENTRY_DSN, set at build time (DEPLOY.md).
    "SENTRY_DSN": "https://7e41d848c6abae7aaf931bd7fa5049e1@o4507767562371072.ingest.us.sentry.io/4511629733855232"
  },
  // Secrets (wrangler secret put, see DEPLOY.md): TURNSTILE_SECRET_KEY, GITHUB_TOKEN,
  // SANITY_WEBHOOK_SECRET, SANITY_VIEWER_TOKEN.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // n8builds.dev and www as Workers custom domains: Cloudflare creates and
  // manages their DNS records and certificates. www redirects to the apex
  // (next.config.mjs). The workers.dev address is turned off.
  "routes": [
    { "pattern": "n8builds.dev", "custom_domain": true },
    { "pattern": "www.n8builds.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
