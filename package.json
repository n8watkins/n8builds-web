{
  "name": "n8builds-web",
  "version": "1.3.0",
  "description": "Nathan Watkins' site: apps, AI tools, Chrome extensions and the N8's Notions blog (n8builds.dev).",
  "homepage": "https://n8builds.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8watkins/n8builds-web.git"
  },
  "license": "MIT",
  "author": "Nathan Watkins",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3737",
    "build": "next build",
    "start": "next start -p 3737",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts",
    "check:cf-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false --check cloudflare-env.d.ts",
    "db:migrate": "wrangler d1 migrations apply n8builds-waitlist --remote && wrangler d1 migrations apply n8builds-analytics --remote",
    "db:migrate:local": "wrangler d1 migrations apply n8builds-waitlist --local && wrangler d1 migrations apply n8builds-analytics --local",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf out",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=api --project=chromium",
    "test:e2e:all": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs",
    "analyze": "next analyze",
    "prepare": "husky",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run type-check && npm run test:unit"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@marsidev/react-turnstile": "^1.5.3",
    "@opennextjs/cloudflare": "1.20.15",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.14.1",
    "@sentry/nextjs": "^11.10.0",
    "@sentry/replay": "11.10.0",
    "clsx": "^2.1.1",
    "lottie-react": "^3.1.2",
    "motion": "^14.9.0",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.91.0",
    "react-icons": "^5.2.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-lottie": "^1.2.10",
    "chrome-launcher": "^1.2.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "release-kit": "github:n8watkins/release-kit#v2.6.0",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "4.157.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
