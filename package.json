{
  "name": "n8builds-web",
  "version": "1.0.0",
  "description": "Nathan Watkins' site: apps, AI tools, Chrome extensions and the N8 Notions blog (n8builds.dev).",
  "homepage": "https://n8builds.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8watkins/n8builds-web.git"
  },
  "license": "MIT",
  "author": "Nathan Watkins",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev -p 3737",
    "build": "next build --webpack",
    "start": "next start -p 3737",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf out",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=api --project=chromium",
    "test:e2e:all": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lighthouse": "node scripts/lighthouse.mjs",
    "analyze": "ANALYZE=true npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.5.3",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.23.0",
    "@sentry/nextjs": "^10.61.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "lottie-react": "^2.4.1",
    "motion": "^14.0.0",
    "next": "^16.2.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.2.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-lottie": "^1.2.10",
    "chrome-launcher": "^1.2.2",
    "dotenv": "^17.2.2",
    "eslint": "^10",
    "eslint-config-next": "^16.2.7",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^16.2.4",
    "postcss": "^8",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
