{
  "$comment": [
    "Which browser tests a pull request runs (scripts/e2e-matrix.mjs, tests/e2e/README.md).",
    "shared: a change here runs the whole suite. none: no browser test depends on it.",
    "groups: each area's spec files and the source files that own it. A changed file runs the specs of its own groups and of every group owning a file that imports it, however indirectly.",
    "inherit: building blocks with no area of their own; they take the groups of what imports them.",
    "always: groups that join every pull request that runs any area.",
    "Anything this file doesn't name runs the whole suite. tests/unit/e2e-matrix.test.ts fails when a spec or a source file is missing from it."
  ],
  "shared": [
    "app/layout.tsx",
    "app/provider.tsx",
    "app/globals.css",
    "app/fonts/**",
    "app/web-vitals.tsx",
    "components/ErrorBoundary.tsx",
    "components/WebVitalsHUD.tsx",
    "components/ui/PartIconClock.tsx",
    "lib/performance.ts",
    "lib/security/headers.mjs",
    "lib/sentry/**",
    "lib/sentry-*.ts",
    "next.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    "package.json",
    "package-lock.json",
    ".npmrc",
    "playwright.config.ts",
    "tests/e2e-env.ts",
    "tests/e2e/areas.json",
    "scripts/e2e-matrix.mjs",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.edge.config.ts",
    "sentry.server.config.ts",
    "wrangler.jsonc",
    "migrations/**",
    "public/_headers",
    ".github/**"
  ],
  "none": [
    "**/*.md",
    "docs/**",
    "LICENSE",
    "tests/unit/**",
    "scripts/**",
    "worker/**",
    "eslint.config.mjs",
    "vitest.config.mts",
    "components.json",
    "global.d.ts",
    "cloudflare-env.d.ts",
    "open-next.config.ts",
    "vercel.json",
    ".vercelignore",
    ".env.example",
    ".gitignore",
    ".prettierrc.json",
    ".release.json",
    ".local-ops.yaml",
    ".husky/**",
    ".vscode/**"
  ],
  "inherit": [
    "lib/**",
    "hooks/**",
    "data/**",
    "components/ui/**",
    "components/MotionProvider.tsx",
    "components/SectionErrorBoundary.tsx",
    "components/ShimmerWhenSeen.tsx",
    "tests/e2e/*.ts"
  ],
  "always": ["site"],
  "lighthouse": {
    "$comment": [
      "Which Lighthouse pages (scripts/lighthouse.mjs PAGES) a pull request audits, by the route file each page renders.",
      "A changed file audits the pages whose route imports it, however indirectly; a shared file (and anything in run) audits them all; skip, none and pages no audited route uses audit nothing.",
      "An image under public/ audits the pages of the areas that own it (or all of them when no area does)."
    ],
    "pages": {
      "/": "app/page.tsx",
      "/blog": "app/blog/page.tsx",
      "/builds": "app/builds/page.tsx",
      "/builds/solara": "app/builds/[slug]/page.tsx",
      "/loadout": "app/loadout/page.tsx"
    },
    "run": ["scripts/lighthouse.mjs"],
    "skip": ["data/**", "tests/**", "playwright.config.ts", "migrations/**", "scripts/e2e-matrix.mjs"]
  },
  "groups": {
    "site": {
      "specs": ["tests/e2e/pages.spec.ts", "tests/e2e/security-headers.spec.ts"],
      "sources": ["app/not-found.tsx", "app/global-error.tsx", "app/api/health/**", "app/monitoring/**", "app/privacy/**", "public/.well-known/**"]
    },
    "home": {
      "specs": ["tests/e2e/reduced-motion.spec.ts", "tests/e2e/reveal.spec.ts"],
      "sources": ["app/page.tsx", "components/HomePage.tsx", "components/HomeEffects.tsx"]
    },
    "chrome": {
      "specs": [
        "tests/e2e/navigation.spec.ts",
        "tests/e2e/navigation-scroll.spec.ts",
        "tests/e2e/header-hovers.spec.ts",
        "tests/e2e/socials.spec.ts"
      ],
      "sources": ["components/layout/**", "data/socials.ts", "public/brand/**", "public/footer-grid.svg"]
    },
    "hero": {
      "specs": ["tests/e2e/hero.spec.ts"],
      "sources": ["components/sections/Hero*.tsx", "components/features/WhoamiTerminal.tsx", "public/hero/**"]
    },
    "now": {
      "specs": ["tests/e2e/now.spec.ts", "tests/e2e/tech-for-pros.spec.ts"],
      "sources": [
        "components/sections/NowBuilding.tsx",
        "components/sections/NowCarousel.tsx",
        "components/sections/QuoteForm.tsx",
        "components/sections/TemplateCarousel.tsx",
