# ========================================
# ENVIRONMENT CONFIGURATION
# ========================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control

# ========================================
# SITE CONFIGURATION
# ========================================

# Your site URL (used for metadata, redirects, and CORS)
NEXT_PUBLIC_SITE_URL=https://n8builds.dev

# Site name (reserved/unused - the site name is currently hard-coded in app/layout.tsx)
# NEXT_PUBLIC_SITE_NAME=n8builds

# ========================================
# GOOGLE ANALYTICS
# ========================================

# Google Analytics Measurement ID (format: G-XXXXXXXXXX)
# Get this from: https://analytics.google.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ========================================
# SANITY (N8'S NOTIONS BLOG)
# ========================================

# Sanity project ID for the N8's Notions blog (read-only CDN client).
# REQUIRED: lib/sanity.ts throws at import time if this is unset, so a fresh
# clone crashes on startup without it. (dataset "production" / apiVersion are
# hard-coded in lib/sanity.ts.)
NEXT_PUBLIC_SANITY_PROJECT_ID=abgyc32w

# ========================================
# CLOUDFLARE TURNSTILE
# ========================================
# Create the widget in "Invisible" (or "Managed") mode in the Cloudflare
# Turnstile dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Cloudflare provides always-pass test keys for local dev:
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA

# Turnstile Site Key (public - exposed to client)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Turnstile Secret Key (private - server-side only)
# REQUIRED in every production build: without it the contact form rejects
# all submissions (Turnstile is only skipped under `next dev`).
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Optional: comma-separated hostnames a Turnstile token may be issued on.
# Defaults to the NEXT_PUBLIC_SITE_URL host plus its www. variant.
# TURNSTILE_ALLOWED_HOSTNAMES=n8builds.dev,www.n8builds.dev

# ========================================
# RATE LIMITING
# ========================================
# The contact form's and waitlist's counters (5/hour per IP plus the daily
# caps) are Durable Objects on the Worker (RATE_LIMIT_COUNTERS in
# wrangler.jsonc), so there is nothing to set here. Without the binding
# production rejects rather than running unlimited; `next dev` keeps them in
# memory. Counter names outside production are namespaced by APP_ENV.

# Optional: site-wide cap on verified submissions per day (default 50)
# CONTACT_DAILY_LIMIT=50

# Local end-to-end tests only. Sends no email, always uses the in-memory rate
# limiter (even on the Worker), and accepts Cloudflare's test-key
# hostname. Ignored whenever APP_ENV is set (every deployed Worker).
# CONTACT_TEST_MODE=1

# ========================================
# LIVE STREAMS (corner player, /live, navbar live dot)
# ========================================
# Live detection (lib/live.ts). The Sanity "Live status" switch always works
# (it uses NEXT_PUBLIC_SANITY_PROJECT_ID above); Twitch and YouTube are checked
# only when their credentials are set. Server-side only, never NEXT_PUBLIC_.

# Twitch developer app (dev.twitch.tv, client type Confidential).
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# YouTube Data API v3 key (restrict it to that API) and the channel ID
# ("UC" + 22 characters, from YouTube Studio > Settings > Channel > Advanced).
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=

# Temporary: a specific YouTube video to treat as live (an unlisted test
# stream). Without YOUTUBE_API_KEY it counts as live unchecked; remove it after.
# LIVE_YOUTUBE_VIDEO_ID=

# Where /live goes, and which tab opens, when live on several platforms
# (twitch, youtube, x or other; default twitch).
# LIVE_PREFERRED_PLATFORM=twitch

# Local end-to-end tests only: fake live answers, picked by the n8-live-test
# cookie (none, twitch, youtube, both, x, all, youtube-no-embed, other), else
# LIVE_TEST_SCENARIO, else offline. Ignored on Vercel.
# LIVE_TEST_MODE=1
# LIVE_TEST_SCENARIO=none

# ========================================
# EMAIL CONFIGURATION (CLOUDFLARE EMAIL SERVICE)
# ========================================
# Mail goes through the shared mailroom Worker over the MAILROOM service
# binding (wrangler.jsonc), so there is no key. It sends only on Cloudflare;
# locally and in tests, CONTACT_TEST_MODE=1 keeps mail in the test outbox.

# Email address to receive contact form submissions
# Must be a real inbox, NOT a forwarding alias that routes back to the same
# inbox (Gmail dedupes self-sent forwarded mail, so submissions would never appear)
CONTACT_EMAIL_TO=your.email@example.com

# Public From/reply address shown in outgoing mail (default contact@n8builds.dev).
# Receiving replies needs a routing rule for this address (e.g. Cloudflare
# Email Routing → Gmail).
CONTACT_EMAIL_FROM=contact@yourdomain.com

# ========================================
# SOCIAL MEDIA LINKS
# ========================================

# These are used in email templates and footer
LINKEDIN_URL=https://www.linkedin.com/in/yourprofile
GITHUB_URL=https://github.com/yourusername
X_URL=https://x.com/yourusername
CAL_URL=https://cal.com/yourusername/intro

# Optional override for the Appturnity link in email templates
# (defaults to https://appturnity.com if unset)
# APPTURNITY_URL=https://appturnity.com

# ========================================
# SENTRY (error monitoring)
# ========================================

# Sentry IS wired up (@sentry/nextjs + sentry.*.config.ts + instrumentation,
# org "nathan-watkins" / project "n8builds" hardcoded in next.config.mjs).
# It stays fully inert until you set NEXT_PUBLIC_SENTRY_DSN - without a DSN the
# SDK is disabled (no network calls). Get the DSN from your Sentry project:
# Settings -> Projects -> n8builds -> Client Keys (DSN). Set it here AND in Vercel.
# Heads up: with a DSN live, the SDK collects user IPs (sendDefaultPii) and records
# Session Replays - disclose that in the privacy policy.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to UPLOAD SOURCE MAPS so prod stack traces are readable (optional).
# Without it the build still succeeds; you just get minified traces. Create at
# Sentry -> Settings -> Auth Tokens (scopes: project:releases, org:read). Locally,
# put it in .env.sentry-build-plugin (gitignored); on Vercel set it as a build env var.
SENTRY_AUTH_TOKEN=

# ========================================
# SITE DOMAIN (OPTIONAL)
# ========================================

# Your domain without protocol (used in email templates)
SITE_URL=https://n8builds.dev
SITE_DOMAIN=n8builds.dev

# ========================================
# BUILD & DEPLOYMENT
# ========================================

# CI environment flag (automatically set by most CI providers)
CI=false

# ========================================
# VERCEL (AUTOMATICALLY SET)
# ========================================

# These are automatically set by Vercel, no need to configure:
# VERCEL=1
# VERCEL_ENV=production|preview|development
# VERCEL_URL=your-deployment-url.vercel.app
# NEXT_PUBLIC_VERCEL_URL=your-deployment-url.vercel.app

# ========================================
# NOTES
# ========================================

# Required for production:
# - NEXT_PUBLIC_SITE_URL
# - NEXT_PUBLIC_GA_ID
# - NEXT_PUBLIC_SANITY_PROJECT_ID (lib/sanity.ts throws at import without it)
# - NEXT_PUBLIC_TURNSTILE_SITE_KEY
# - TURNSTILE_SECRET_KEY

# Optional (have defaults):
# - CONTACT_EMAIL_TO
# - Social media URLs

